# ============================================================
# 气象预警接入配置（复制成 .env 后填写：cp .env.example .env）
#   ⚠️ .env 已被 .gitignore 忽略，密钥不会进版本库；不要把它写进任何前端代码。
#   优先级：命令行参数 > 真实环境变量 > .env 文件 > 默认值
# ============================================================

# ---------- 1. 位置（默认已经是寿光市三元朱村，一般不用改） ----------
WEATHER_LAT=36.88
WEATHER_LON=118.73
WEATHER_LOCATION=山东省寿光市三元朱村

# 预警写进 crops[].alerts 的哪个桶：risk（灾害风险）/ supply / price
WEATHER_ALERT_BUCKET=risk

# ---------- 2. 选数据源 ----------
# mock（模拟，不需要任何注册） / apihz（接口盒子） / caiyun（彩云天气） / generic（自定义任何 HTTP JSON 接口）
ALERT_PROVIDER=apihz

# ---------- 3. 接口地址（最关键的一项） ----------
# A) 用完整 URL（推荐：注册后在平台文档里复制真实接口地址贴这里）
#    支持占位符：{lat} {lon} {id} {key} {token} {endpoint}
# ALERT_API_URL=https://cn.apihz.cn/api/tianqi/xxxxxx.php
#
# B) 或者只填接口盒子接口的路径名（会自动拼成 https://cn.apihz.cn/api/tianqi/{名字}.php）
#    这个名字要在 apihz 站内「天气预报」分类里找「预警」类接口的文档页确认
ALERT_APIHZ_ENDPOINT=tianqi

# 请求方式与额外参数（GET 默认；POST 时用 ALERT_API_BODY 传 JSON）
ALERT_API_METHOD=GET
# ALERT_API_PARAMS={"vip":"1"}
# ALERT_API_HEADERS={"Referer":"https://www.apihz.cn/"}
# ALERT_API_BODY={}

# 预警数组在响应 JSON 里的路径（点路径）。留空则用各 provider 的默认值：
#   apihz → data     caiyun → result.alert
# ALERT_JSON_PATH=data
# 若字段名和默认映射不一致，用这个覆盖（JSON：统一字段名 → 接口里的字段路径）
# ALERT_FIELD_MAP={"title":"warningTitle","text":"warningText","level":"warningLevel","type":"warningType"}

# 来源标注（会写进 meta.weather_source / meta.sources，前端展示用）
# ALERT_SOURCE_LABEL=接口盒子 apihz.cn（数据来源：中国气象局）

# ---------- 4. 凭证（注册后填；不填就跑 --mock） ----------
# 接口盒子：注册 https://www.apihz.cn → 后台「个人资料」查看 ID 与 KEY
# 开发调试可先用公开测试值（官方文档示例用的就是这两个）：
#   APIHZ_ID=88888888
#   APIHZ_KEY=88888888
APIHZ_ID=
APIHZ_KEY=

# 彩云天气：登录 https://dashboard.caiyunapp.com 创建应用后拿到 token
CAIYUN_TOKEN=

# 网络与礼貌性延迟
ALERT_TIMEOUT=15
ALERT_RETRIES=2
